# LibraClub — variables de entorno. Copiar a .env y completar.
# Ningún valor real de este archivo entra al repo.

# PostgreSQL es el único motor de la familia: no hay default a SQLite a
# propósito. Local, contra el compose, el host es el nombre del servicio.
DATABASE_URL=postgresql+psycopg://libraclub:CAMBIAR@libraclub-postgres:5432/libraclub
LIBRACLUB_POSTGRES_PASSWORD=CAMBIAR

ENTORNO=dev
DEBUG=0

# Huso horario del ecosistema: UTC-3 fijo, sin horario de verano.
TZ=America/Argentina/Buenos_Aires

# Firma de la cookie de sesión. Sin esto la app NO levanta (salvo
# ENV=development, que sólo sirve para correr local).
SECRET_KEY=CAMBIAR

# Usuario inicial. Fail-closed: sin la contraseña la app no arranca, en vez de
# crear un admin con una clave que nadie eligió.
LIBRACLUB_ADMIN_USERNAME=admin
LIBRACLUB_ADMIN_PASSWORD=CAMBIAR

# Token con el que el backoffice (admin.libraclub.com.ar) administra los
# usuarios de esta instancia. Vacío o ausente = la API de usuarios pide sesión
# de admin, como siempre. Se genera con `openssl rand -hex 32` y tiene que ser
# EL MISMO que el de /etc/libraclub-admin.env en el servidor.
LIBRA_SERVICE_TOKEN=

# Credencial que usa el PANEL DEL DUEÑO para leer `GET /api/resumen`.
# 🔴 **No reusar `LIBRA_SERVICE_TOKEN`**: ése es uno por producto,
# compartido por todas las instancias de todos los clientes, así que
# dárselo al dueño de un complejo le abriría las instancias de otros. Éste
# es propio de ESTA instancia. Vacío o ausente = esta sucursal no le
# contesta al panel. Se genera con `openssl rand -hex 32`.
LIBRA_PANEL_TOKEN=
